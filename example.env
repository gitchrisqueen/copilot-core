# Copy to .env and fill in what you use. Every key is optional; unset keys just mean that
# provider/service is skipped. This file is never read directly by an app -- copy it, and only
# .env (git-ignored) is loaded.

# LLM providers (cloud fallbacks; local Ollama needs no key, only a reachable url in config.js)
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_API_KEY=

# Together AI (hosted Whisper/Parakeet transcription, proxied server-side by logserver.py)
TOGETHER_API_KEY=
